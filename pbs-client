#!/usr/bin/env python3
# pbs-client: small wrapper for proxmox-backup-client that loads repo env from files
# Place me at /usr/local/bin/pbs-client and chmod +x.
# Default repo directory can be overridden with PBS_PROFILE_DIR or /etc/pbs-client/repos.d

import logging
import os
import re
import stat
import sys
from pathlib import Path

PROXMOX_CLIENT = "/usr/local/bin/proxmox-backup-client"

ALLOWED_KEYS = {
    "PBS_REPOSITORY",
    "PBS_PASSWORD",
    "PBS_FINGERPRINT",
    "PBS_ENCRYPTION_PASSWORD",
    "PBS_KEYFILE",
}

DEFAULT_DIRS = [
    os.environ.get("PBS_PROFILE_DIR", ""),
    "/mnt/user/appdata/pbs/repos.d",
    "/boot/config/pbs/repos.d",
    "/etc/pbs-client/repos.d",
]

log = logging.getLogger("pbs-client")


def setup_logging(level_name: str) -> None:
    level = getattr(logging, level_name.upper(), None)
    if not isinstance(level, int):
        print(f"pbs-client: invalid log level '{level_name}'", file=sys.stderr)
        sys.exit(1)
    logging.basicConfig(
        level=level,
        format="pbs-client: %(levelname)s: %(message)s",
        stream=sys.stderr,
    )
    log.debug("log level set to %s", level_name.upper())


def find_profile_dir() -> str:
    for d in DEFAULT_DIRS:
        if not d:
            continue
        if Path(d).is_dir():
            log.debug("profile directory found: %s", d)
            return d
        log.debug("profile directory candidate not found: %s", d)
    return ""


def usage(profile_dir: str) -> None:
    print(f"""\
pbs-client — wrapper for proxmox-backup-client using named repository profiles

Usage:
  pbs-client [--profile-dir DIR] [--log-level LEVEL] [--default NAME] [--list]
             <proxmox-backup-client subcommand and args…>

Examples:
  pbs-client backup vm.qcow2:/path --repository my-pbs
  pbs-client --list
  pbs-client --default my-pbs backup …      # use NAME if --repository not provided
  pbs-client --log-level debug backup …     # verbose wrapper output

Log levels (default WARNING, also via PBS_LOG_LEVEL env var):
  debug, info, warning, error

Profiles live in: {profile_dir}
Each profile is a file named NAME.env containing environment lines, e.g.:
  PBS_REPOSITORY="backup@pbs!unraid@10.10.1.50:datastore1"
  PBS_PASSWORD="your_api_token_secret"
  PBS_FINGERPRINT="aa:bb:cc:…"

Notes:
- If --repository VALUE looks like a full repo string (contains ':' or '@pbs@'),
  it will be passed through unchanged (no profile lookup).""")


def list_profiles(profile_dir: str) -> None:
    print(f"Profiles in: {profile_dir}")
    env_files = sorted(Path(profile_dir).glob("*.env"))
    for f in env_files:
        print(f"  {f.stem}")


def load_profile_env(profile_dir: str, name: str) -> None:
    path = Path(profile_dir) / f"{name}.env"
    log.debug("loading profile '%s' from %s", name, path)

    if not path.is_file():
        log.error("profile '%s' not found at %s", name, path)
        sys.exit(2)

    try:
        mode = stat.S_IMODE(path.stat().st_mode)
        log.debug("%s permissions: %o", path, mode)
        if mode > 0o600:
            log.warning("%s permissions are loose; consider chmod 600.", path)
    except OSError:
        pass

    # Matches: KEY="value", KEY='value', KEY=value
    line_re = re.compile(r'^([A-Za-z_][A-Za-z0-9_]*)=(.*)$')
    loaded: list[str] = []

    with path.open() as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            m = line_re.match(line)
            if not m:
                log.debug("skipping unparseable line in %s", path)
                continue
            key, val = m.group(1), m.group(2)
            if key not in ALLOWED_KEYS:
                log.debug("ignoring disallowed key '%s'", key)
                continue
            # Strip surrounding single or double quotes
            if len(val) >= 2 and val[0] == val[-1] and val[0] in ('"', "'"):
                val = val[1:-1]
            os.environ[key] = val
            loaded.append(key)
            log.debug("set env var %s", key)

    log.info("loaded profile '%s': set %s", name, ", ".join(loaded) if loaded else "(nothing)")


def looks_like_repo_string(value: str) -> bool:
    return ":" in value or "@pbs@" in value


def main() -> None:
    args = sys.argv[1:]

    # --- Bootstrap logging from env before touching args ---
    log_level = os.environ.get("PBS_LOG_LEVEL", "WARNING")

    # --- Consume --profile-dir and --log-level before anything else ---
    profile_dir = find_profile_dir()

    remaining: list[str] = []
    i = 0
    while i < len(args):
        if args[i] == "--profile-dir":
            if i + 1 >= len(args):
                print("pbs-client: --profile-dir requires an argument", file=sys.stderr)
                sys.exit(1)
            profile_dir = args[i + 1]
            log.debug("--profile-dir override: %s", profile_dir)
            i += 2
        elif args[i] == "--log-level":
            if i + 1 >= len(args):
                print("pbs-client: --log-level requires an argument", file=sys.stderr)
                sys.exit(1)
            log_level = args[i + 1]
            i += 2
        else:
            remaining.append(args[i])
            i += 1

    setup_logging(log_level)
    args = remaining

    log.debug("profile directory: %s", profile_dir or "(none)")

    # --- Early-exit flags ---
    if not args or args[0] in ("--help", "-h"):
        usage(profile_dir)
        sys.exit(0)

    if args[0] == "--list":
        if not profile_dir:
            log.error("no profile directory found.")
            sys.exit(1)
        list_profiles(profile_dir)
        sys.exit(0)

    # --- --default flag ---
    default_profile = ""
    if args and args[0] == "--default":
        if len(args) < 2:
            log.error("--default requires an argument")
            sys.exit(1)
        default_profile = args[1]
        log.debug("default profile: %s", default_profile)
        args = args[2:]

    # --- Require a profile dir from here on ---
    if not profile_dir:
        log.error(
            "no profile directory found. Create one, e.g.: /mnt/user/appdata/pbs/repos.d"
        )
        print(
            "           or run: pbs-client --profile-dir /path/to/repos.d ...",
            file=sys.stderr,
        )
        sys.exit(1)

    log.info("using profile directory: %s", profile_dir)

    # --- Parse --repository / -r from the remaining args ---
    repo_arg = ""
    pass_args: list[str] = []
    i = 0
    while i < len(args):
        if args[i] in ("--repository", "-r"):
            if i + 1 >= len(args):
                log.error("%s requires an argument", args[i])
                sys.exit(2)
            repo_arg = args[i + 1]
            log.debug("found %s: %s", args[i], repo_arg)
            i += 2
        elif args[i] in ("--profile-dir", "--default", "--list"):
            log.error("option '%s' must be used before the subcommand.", args[i])
            sys.exit(2)
        else:
            pass_args.append(args[i])
            i += 1

    if not repo_arg and default_profile:
        log.debug("no --repository given; falling back to default profile '%s'", default_profile)
        repo_arg = default_profile

    # --- Resolve repo_arg to env or pass-through ---
    if repo_arg:
        if looks_like_repo_string(repo_arg):
            log.info("treating --repository value as a direct repo string")
            log.debug("setting PBS_REPOSITORY from argument")
            os.environ["PBS_REPOSITORY"] = repo_arg
        else:
            log.info("loading profile '%s'", repo_arg)
            load_profile_env(profile_dir, repo_arg)
    else:
        log.debug("no repository argument; relying on environment")

    log.info("exec: %s %s", PROXMOX_CLIENT, " ".join(pass_args))
    log.debug("pass_args: %r", pass_args)

    # --- Exec proxmox-backup-client ---
    os.execv(PROXMOX_CLIENT, [PROXMOX_CLIENT] + pass_args)


if __name__ == "__main__":
    main()
