# pbc-wrapper profile — copy to <profile-name>.env and fill in your values.
# Secure the file after editing: chmod 600 <profile-name>.env

# Required: repository connection string
# Format: user@realm!tokenid@host:datastore
# Examples:
#   backup@pbs!mytoken@10.0.0.1:tank
#   backup@pbs!mytoken@pbs.example.com:datastore1
PBS_REPOSITORY="backup@pbs!tokenid@192.168.1.100:datastore"

# Required: API token secret (from PBS: Datacenter -> API Tokens)
PBS_PASSWORD="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Required: TLS fingerprint of the PBS server
# Retrieve with: proxmox-backup-client api get /nodes/localhost/certificates/info
# Or from PBS web UI: Dashboard -> Show Fingerprint
PBS_FINGERPRINT="aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"

# Optional: path to a client-side encryption key file
# Only used if the file exists on disk; silently skipped otherwise.
# Check the fingerprint of a key: proxmox-backup-client key show /path/to/file.key
#PBS_KEYFILE="/etc/pbs-client/encryption.key"

# Optional: passphrase to unlock an encrypted key file (if the key has kdf != none)
#PBS_ENCRYPTION_PASSWORD="your-key-passphrase"
